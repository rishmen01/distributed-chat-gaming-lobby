<Window x:Class="GamingLobbyPollingClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gaming Lobby Polling Client"
        Height="680" Width="1100" MinHeight="580" MinWidth="900" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#E9EBEE"
        Closed="Window_Closed">
    <!-- softer gray background -->

    <Window.Resources>
        <!-- Button Style (Blue) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <!-- blue -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                                <!-- darker blue hover -->
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                                <!-- pressed -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Darker Panel Background -->
        <SolidColorBrush x:Key="PanelBackground" Color="#D0D3D8"/>
        <!-- medium gray -->
    </Window.Resources>

    <!--pagewide scroll-->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Menu -->
                <RowDefinition Height="Auto"/>
                <!--login-->
                <RowDefinition Height="*"/>
                <!--body-->
            </Grid.RowDefinitions>

            <!-- ===== Menu ===== -->
            <Menu Grid.Row="0" Background="#1565C0">
                <MenuItem Header="_File">
                    <!-- Keep top-level File text white -->
                    <MenuItem.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="White"/>
                        </DataTemplate>
                    </MenuItem.HeaderTemplate>

                    <!-- Submenu items black -->
                    <MenuItem Header="New _Window" Click="MenuNewWindow_Click" Foreground="Black"/>
                    <MenuItem Header="New _Process" Click="MenuNewProcess_Click" Foreground="Black"/>
                    <Separator/>
                    <MenuItem Header="E_xit" Click="MenuExit_Click" Foreground="Black"/>
                </MenuItem>
            </Menu>


            <!--=====login=====-->
            <Grid Grid.Row="1" Margin="0,8,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UsernameTextBox" Grid.Column="0" MinWidth="100"
                         Margin="0,0,8,0" Padding="5" IsEnabled="True"/>
                <Button x:Name="LoginButton" Grid.Column="1" Content="Login"
                        MinWidth="90" Click="LoginButton_Click"/>
                <Button x:Name="LogoutButton" Grid.Column="2" Content="Logout"
                        MinWidth="90" Click="LogoutButton_Click" IsEnabled="False"/>
            </Grid>

            <!--=====body=====-->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--rooms+room chat-->
                <StackPanel Grid.Column="0">

                    <!-- rooms -->
                    <TextBlock Text="Rooms" FontWeight="Bold" FontSize="14"/>
                    <ListBox x:Name="RoomListBox"
                             IsEnabled="False"
                             Height="140"
                             Margin="0,2,0,8"
                             Background="{StaticResource PanelBackground}"
                             BorderBrush="#B0B3B8"
                             SelectionChanged="RoomListBox_SelectionChanged"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewRoomTextBox" Grid.Column="0" MinWidth="70"
                                 Margin="0,0,6,0" Padding="5" IsEnabled="False"/>
                        <Button x:Name="CreateRoomButton" Grid.Column="1" Content="Create Room"
                                MinWidth="105" Click="CreateRoomButton_Click" IsEnabled="False"/>
                        <Button x:Name="JoinRoomButton" Grid.Column="2" Content="Join Room"
                                MinWidth="95" Click="JoinRoomButton_Click" IsEnabled="False"/>
                        <Button x:Name="LeaveRoomButton" Grid.Column="3" Content="Leave Room"
                                MinWidth="95" Click="LeaveRoomButton_Click" IsEnabled="False"/>
                    </Grid>

                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurrentRoomHeader" Grid.Column="0" Text="No room selected"
                                   FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <Button x:Name="RefreshNowButton" Grid.Column="1" Content="Refresh Now"
                                MinWidth="100" Margin="3" Click="RefreshNowButton_Click" IsEnabled="False"
                                ToolTip="Immediately refresh rooms, players, messages and shared files"/>
                        <TextBlock x:Name="LastRefreshText" Grid.Column="2" Text="Not refreshed yet"
                                   Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"
                                   Foreground="#555555"/>
                    </Grid>

                    <!-- room chat -->
                    <RichTextBox x:Name="ChatBox"
                                 IsDocumentEnabled="True"
                                 MinHeight="160"
                                 Height="220"
                                 IsReadOnly="True"
                                 Background="{StaticResource PanelBackground}"
                                 BorderBrush="#B0B3B8"
                                 VerticalScrollBarVisibility="Visible"
                                 Margin="0,2,0,8"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MessageTextBox" Grid.Column="0" MinWidth="60"
                                 Margin="0,0,6,0" Padding="5" IsEnabled="False"
                                 VerticalContentAlignment="Center"/>
                        <Button x:Name="SendButton" Grid.Column="1" Content="Send"
                                MinWidth="76" Click="SendMessageButton_Click" IsEnabled="False"/>
                        <Button x:Name="ShareRoomFileButton" Grid.Column="2" Content="Share File"
                                MinWidth="100" Margin="6,0,0,0" IsEnabled="False"
                                Click="ShareRoomFileButton_Click"/>
                    </Grid>
                </StackPanel>

                <!--players+private chat-->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Players in Room" FontWeight="Bold" FontSize="14"/>
                    <ListBox x:Name="PlayerListBox"
                             IsEnabled="False"
                             Height="300"
                             Margin="0,2,0,8"
                             Background="{StaticResource PanelBackground}"
                             BorderBrush="#B0B3B8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PrivateChatButton" Grid.Column="0" Content="Private Chat"
                                Margin="3" Click="OpenPrivateChatButton_Click" IsEnabled="False"/>
                        <Button x:Name="RefreshPlayersButton" Grid.Column="1" Content="Refresh Players"
                                Margin="3" Click="RefreshPlayersButton_Click" IsEnabled="False"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
